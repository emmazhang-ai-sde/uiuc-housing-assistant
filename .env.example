# ── LLM Provider ──────────────────────────────────────────────────────────────
#
# Option A: Groq (RECOMMENDED)
#   - Works for both local development and cloud deployment
#   - Free tier: 30 req/min, 14,400 req/day — sufficient for personal use
#   - Get a free API key at https://console.groq.com
#
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Option B: Ollama (local only)
#   - No API key needed, runs entirely on your machine
#   - Requires: Ollama installed + model pulled (ollama pull llama3.1:8b, ~5 GB)
#   - Does NOT work in cloud deployment (Railway, Render, etc.)
#
# LLM_PROVIDER=ollama

# ── Supabase Auth ──────────────────────────────────────────────────────────────
# JWT verification is done against the Supabase project's public JWKS endpoint
# (ES256 signing keys) — no shared secret needed. Only set SUPABASE_URL if you
# point the app at a different Supabase project than the built-in default.
# SUPABASE_URL=https://your-project-ref.supabase.co

# Only needed for local admin scripts (e.g. scripts/bulk_invite.py). Get it from
# Dashboard → Settings → API → service_role secret. Full admin power, bypasses
# RLS — never commit it, never use it in frontend/backend request-serving code.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Only needed for scripts/resend_pending_reminder.py. Get it from Resend
# Dashboard → API Keys → a Sending key (re_...). Never commit it.
# RESEND_API_KEY=your_resend_api_key_here
# RESEND_FROM_ADDRESS=UIUC Housing AI <hello@uiuc-housing-ai.com>  # optional, this is the default
